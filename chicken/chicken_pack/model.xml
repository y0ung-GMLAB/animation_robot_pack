    <motor name="act_head_yaw" joint="head_yaw" ctrlrange="-0.6 0.6" ctrllimited="true"/>
    <motor name="act_crank_l" joint="crank_l" ctrlrange="-4.1 4.1" ctrllimited="true"/>
    <motor name="act_crank_r" joint="crank_r" ctrlrange="-4.1 4.1" ctrllimited="true"/>
